# Copy to .dev.vars for local development (overrides wrangler.jsonc vars).
SLEEPER_LEAGUE_ID=""
SLEEPER_USER_ID=""

# wrangler.jsonc enables OAuth (AUTH_MODE="github"). To test locally without logging in:
AUTH_MODE="none"

# To test OAuth locally instead, remove the line above and use the *local* GitHub OAuth app:
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# COOKIE_ENCRYPTION_KEY=""
