{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eepy-flare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: required by the OAuth provider for Client ID Metadata Documents (phase 2).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Full NFL players dump, compacted. Refreshed once a day by the cron below.
  // Create with `npx wrangler kv namespace create PLAYERS` and paste the id here.
  "kv_namespaces": [
    { "binding": "PLAYERS", "id": "534337dfad3a401793cd9a740821bd49" },
    // OAuth clients, grants and tokens (phase 2 only; unused while AUTH_MODE is "none").
    // Create with `npx wrangler kv namespace create OAUTH_KV`.
    { "binding": "OAUTH_KV", "id": "22a20c308259487a89174b7b235ae334" }
  ],

  // nflverse stats, snaps, injuries, expected points and schedules (see src/nflverse).
  // Create with `npx wrangler d1 create eepy-flare-nfl` (or the dashboard) and paste the id here.
  // Tables are created automatically by the first sync.
  "d1_databases": [
    { "binding": "NFL_DB", "database_name": "eepy-flare-nfl", "database_id": "d3f31791-295c-44e1-92ca-bdf221083521" }
  ],

  // 09:17 UTC daily: Sleeper players dump (Sleeper asks for at most one fetch per day).
  // :23 hourly: nflverse sync; unchanged files return 304 and are skipped.
  "triggers": { "crons": ["17 9 * * *", "23 * * * *"] },

  "vars": {
    // Set these to your league and Sleeper user. Both are public numeric ids.
    "SLEEPER_LEAGUE_ID": "1378157554336559104",
    "SLEEPER_USER_ID": "1378168866642878464",
    // Comma-separated custom domains serving /mcp (leave empty for *.workers.dev).
    "ALLOWED_HOSTNAMES": "eepy.seance.sh",

    // "none" = authless (phase 1). "github" = OAuth 2.1 with GitHub login (phase 2); also set the
    // secrets GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET and COOKIE_ENCRYPTION_KEY.
    "AUTH_MODE": "github",
    // GitHub logins and/or numeric user ids allowed to sign in (phase 2). Empty = nobody.
    "ALLOWED_GITHUB_USERS": "seano-vs,64788907"
  }
}
